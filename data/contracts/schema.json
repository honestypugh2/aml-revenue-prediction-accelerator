{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RevenueSnapshotRecord",
  "description": "One facility-month-snapshot record. All data is synthetic.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "facility_id",
    "accounting_month",
    "snapshot_date",
    "snapshot_day",
    "service_line_group",
    "generic_payer_group",
    "encounter_class_group",
    "days_elapsed",
    "business_days_elapsed",
    "remaining_days",
    "month",
    "quarter"
  ],
  "properties": {
    "facility_id": { "type": "string", "pattern": "^FAC-\\d{3}$" },
    "accounting_month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "snapshot_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "snapshot_day": { "type": "integer", "minimum": 1, "maximum": 31 },
    "service_line_group": { "type": "string" },
    "generic_payer_group": { "type": "string" },
    "encounter_class_group": { "type": "string" },
    "month_to_date_encounters": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_discharges": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_average_daily_census": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_occupancy_rate": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_case_mix_index": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_length_of_stay": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_observation_rate": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_surgeries_inpatient": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_surgeries_outpatient": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_cath_lab_procedures": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_imaging_procedures": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_inpatient_volume": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_outpatient_volume": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_gross_charges": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_gross_charges_inpatient": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_gross_charges_outpatient": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_payments": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_denials": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_contractual_adjustments": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_bad_debt": { "type": ["number", "null"], "minimum": 0 },
    "month_to_date_charity_care": { "type": ["number", "null"], "minimum": 0 },
    "days_elapsed": { "type": "number", "minimum": 1, "maximum": 31 },
    "business_days_elapsed": { "type": "number", "minimum": 0 },
    "remaining_days": { "type": "number", "minimum": 0 },
    "prior_month_net_revenue": { "type": ["number", "null"] },
    "prior_year_same_month_net_revenue": { "type": ["number", "null"] },
    "rolling_3_month_net_revenue": { "type": ["number", "null"] },
    "rolling_6_month_net_revenue": { "type": ["number", "null"] },
    "rolling_12_month_net_revenue": { "type": ["number", "null"] },
    "historical_collection_rate": { "type": ["number", "null"], "minimum": 0 },
    "historical_denial_rate": { "type": ["number", "null"], "minimum": 0 },
    "historical_adjustment_rate": { "type": ["number", "null"], "minimum": 0 },
    "historical_payer_mix": { "type": ["number", "null"], "minimum": 0 },
    "historical_charge_lag_rate": { "type": ["number", "null"], "minimum": 0 },
    "month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "quarter": { "type": "integer", "minimum": 1, "maximum": 4 },
    "month_sin": { "type": ["number", "null"] },
    "month_cos": { "type": ["number", "null"] },
    "actual_month_end_net_revenue": { "type": "number", "exclusiveMinimum": 0 }
  }
}
