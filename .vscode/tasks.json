{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "generate-data",
      "type": "shell",
      "command": "uv run revenue-prediction generate-data --env dev",
      "problemMatcher": []
    },
    {
      "label": "train-local",
      "type": "shell",
      "command": "uv run revenue-prediction train-local --env dev --out outputs",
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "shell",
      "command": "uv run ruff check src tests && uv run pyright src && uv run pytest -m 'not live'",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "serve",
      "type": "shell",
      "command": "uv run revenue-prediction serve --reload",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend-dev",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
