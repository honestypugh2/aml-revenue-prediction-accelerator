# ---------------------------------------------------------------------------
# Environment configuration template.
# Copy to `.env` and fill in real values LOCALLY. NEVER commit a real `.env`.
# All values below are placeholders. Secrets must never be committed.
# Settings are read with the RPA_ prefix and `__` nested delimiter.
# ---------------------------------------------------------------------------

# Active environment: dev | test | prod
RPA_ENVIRONMENT=dev

# --- Azure Machine Learning workspace (SDK v2) ---
# Provide real values locally; leave as placeholders to stay fully offline.
RPA_AZURE_ML__SUBSCRIPTION_ID=SUBSCRIPTION_ID_PLACEHOLDER
RPA_AZURE_ML__RESOURCE_GROUP=RESOURCE_GROUP_PLACEHOLDER
RPA_AZURE_ML__WORKSPACE_NAME=WORKSPACE_PLACEHOLDER
RPA_AZURE_ML__LOCATION=eastus2
RPA_AZURE_ML__COMPUTE_CLUSTER=cpu-cluster

# --- Microsoft Fabric / OneLake ---
RPA_FABRIC__WORKSPACE_NAME=WORKSPACE_PLACEHOLDER
RPA_FABRIC__LAKEHOUSE_NAME=LAKEHOUSE_PLACEHOLDER
RPA_FABRIC__ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com

# --- Live integration tests (opt-in) ---
# Set to 1 ONLY when you intend to run tests against real cloud resources.
RPA_RUN_LIVE=0

# Authentication uses DefaultAzureCredential (az login / managed identity /
# environment credentials). Do NOT place client secrets or tokens in this file.
