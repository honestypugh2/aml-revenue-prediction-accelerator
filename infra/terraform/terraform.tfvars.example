# Copy to terraform.tfvars and adjust. Do not commit terraform.tfvars.
name_prefix         = "revpred"
location            = "eastus2"
resource_group_name = "rg-revenue-prediction-secure"

vnet_address_space       = ["10.30.0.0/16"]
subnet_private_endpoints = "10.30.1.0/24"
subnet_jumpbox           = "10.30.2.0/24"
subnet_bastion           = "10.30.3.0/26"

jumpbox_admin_username = "azureuser"
jumpbox_vm_size        = "Standard_D2s_v5"

tags = {
  workload    = "revenue-prediction-accelerator"
  data        = "synthetic"
  environment = "prod"
  profile     = "secure"
}
